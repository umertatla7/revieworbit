<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.revieworbit.scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/umertatla/Library/Application Support/Herd/bin/php</string>
        <string>artisan</string>
        <string>schedule:work</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/umertatla/Documents/revieworbit/apps/api</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
