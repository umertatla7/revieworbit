[Unit]
Description=Breviews application backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/breviews
Environment=APP_DIR=/opt/breviews
Environment=BACKUP_RETENTION_DAYS=14
ExecStart=/opt/breviews/infrastructure/scripts/backup-production.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
