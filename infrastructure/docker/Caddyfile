{
    email {$TLS_EMAIL}
}

{$WEB_DOMAIN} {
    encode zstd gzip
    reverse_proxy web:3000

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

{$API_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 21MB
    }

    reverse_proxy nginx:80

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
