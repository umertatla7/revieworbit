# Public hostnames
ROOT_DOMAIN=buckeyerank.com
WEB_DOMAIN=app.buckeyerank.com
API_DOMAIN=api.buckeyerank.com
TLS_EMAIL=admin@buckeyerank.com

# Application
APP_NAME=Breviews
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.buckeyerank.com
WEB_URL=https://app.buckeyerank.com
STRIPE_API_VERSION=2026-02-25.clover
NEXT_PUBLIC_API_URL=https://api.buckeyerank.com
APP_KEY=CHANGE_ME
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL
POSTGRES_DB=revieworbit
POSTGRES_USER=revieworbit
POSTGRES_PASSWORD=CHANGE_ME
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=revieworbit
DB_USERNAME=revieworbit
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Browser authentication
SESSION_DRIVER=database
SESSION_DOMAIN=.buckeyerank.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.buckeyerank.com

# Private application storage
FILESYSTEM_DISK=local

# Staging mail capture. Replace with a transactional provider before production use.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@buckeyerank.com
MAIL_FROM_NAME=Breviews

# Messaging remains fake until Twilio has been explicitly configured and verified.
MESSAGING_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_URL=https://api.buckeyerank.com/api/v1/webhooks/twilio/status
TWILIO_INBOUND_WEBHOOK_URL=https://api.buckeyerank.com/api/v1/webhooks/twilio/inbound
TRACKING_BASE_URL=https://api.buckeyerank.com

# Square remains in sandbox until production approval.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-07-15
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_REDIRECT_URI=https://api.buckeyerank.com/api/v1/integrations/square/callback
SQUARE_HISTORY_DAYS=365
SQUARE_UPCOMING_DAYS=365

# Toast credentials and webhook secrets are stored encrypted from Admin > Toast POS setup.
# Keep sandbox active until Toast approves the partner integration and production scopes.
TOAST_ENVIRONMENT=sandbox
TOAST_HISTORY_DAYS=30
TOAST_CONNECTION_CODE_DAYS=30

# Private pgAdmin login, reached through an SSH tunnel only.
PGADMIN_DEFAULT_EMAIL=admin@buckeyerank.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Optional staging identities. Leave the password empty to skip seeding.
SEED_SUPER_ADMIN_EMAIL=admin@buckeyerank.com
SEED_BUSINESS_OWNER_EMAIL=owner@buckeyerank.com
SEED_DEFAULT_PASSWORD=
