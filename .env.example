# Application URLs
APP_NAME=ReviewOrbit
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Laravel secret: generate locally with `make key`; never commit the value.
APP_KEY=

# Local service credentials (change outside local development)
POSTGRES_DB=revieworbit
POSTGRES_USER=revieworbit
POSTGRES_PASSWORD=revieworbit_local
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=revieworbit
DB_USERNAME=revieworbit
DB_PASSWORD=revieworbit_local
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Herd alternative:
# SESSION_DOMAIN=.revieworbit.test
# SANCTUM_STATEFUL_DOMAINS=revieworbit.test,api.revieworbit.test

# S3-compatible private media storage / MinIO
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=revieworbit
AWS_SECRET_ACCESS_KEY=revieworbit_minio_local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=revieworbit-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_ROOT_USER=revieworbit
MINIO_ROOT_PASSWORD=revieworbit_minio_local

# Local mail capture
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@revieworbit.test
MAIL_FROM_NAME=ReviewOrbit
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Messaging defaults to fake. Set twilio only in an explicitly configured environment.
MESSAGING_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_URL=https://api.revieworbit.test/api/v1/webhooks/twilio/status
TWILIO_INBOUND_WEBHOOK_URL=https://api.revieworbit.test/api/v1/webhooks/twilio/inbound
TRACKING_BASE_URL=https://api.revieworbit.test

# Square — Sandbox by default; production values belong in a secret manager.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-05-20
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/square/callback

# Development seed identities. Passwords must be supplied locally.
SEED_SUPER_ADMIN_EMAIL=admin@revieworbit.test
SEED_PLATFORM_MANAGER_EMAIL=manager@revieworbit.test
SEED_BUSINESS_OWNER_EMAIL=owner@albarbershop.test
SEED_BUSINESS_MANAGER_EMAIL=location-manager@albarbershop.test
SEED_DEFAULT_PASSWORD=
